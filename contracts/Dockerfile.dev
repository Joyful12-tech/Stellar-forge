# Soroban Contract Development Dockerfile
# Base image pinned by digest (multi-arch index) instead of the mutable
# rust:1.75-slim tag, so a re-pushed tag cannot silently change the build base.
FROM rust:1.75-slim@sha256:70c2a016184099262fd7cee46f3d35fec3568c45c62f87e37f7f665f766b1f74

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm --rf /var/lib/apt/lists/*

# Install wasm32 target for Rust
RUN rustup target add wasm32v1-none

# Install wasm-opt for optimization
RUN curl -L https://github.com/WebAssembly/binaryen/releases/download/version_116/binaryen-version_116-x86_64-linux.tar.gz \
    | tar -xz -C /tmp \
    && cp /tmp/binaryen-version_116/bin/wasm-opt /usr/local/bin/ \
    && rm -rf /tmp/binaryen-version_116

# Install Stellar CLI
RUN curl -L https://github.com/stellar/stellar-cli/releases/download/v21.5.0/stellar-cli-21.5.0-x86_64-unknown-linux-gnu.tar.gz \
    | tar -xz -C /tmp \
    && mv /tmp/stellar /usr/local/bin/stellar \
    && chmod +x /usr/local/bin/stellar

# Set working directory
WORKDIR /contracts

# Copy Cargo files for better caching
COPY Cargo.toml Cargo.lock ./
COPY token-factory/Cargo.toml ./token-factory/

# Create a non-root user for the dev/build process
RUN useradd -m -s /bin/bash builder

# Create dummy source files to cache dependencies
RUN mkdir -p token-factory/src \
    && echo "fn main() {}" > token-factory/src/lib.rs \
    && cargo build --target wasm32v1-none --release \
    && rm -rf token-factory/src

# Copy actual source code
COPY . .

# Give the non-root user ownership of the source tree and CARGO_HOME so that
# `cargo build` (run at dev time via the bind-mounted source and the persisted
# /contracts/target volume) can write its output without root.
RUN chown -R builder:builder /contracts /usr/local/cargo

# Drop root privileges for the dev/build process
USER builder

# Default command for interactive development
CMD ["bash"]