fn require_whitelisted(env: &Env, state: &State, creator: &Address) -> Result<(), Error> {
    if !state.whitelist.contains(creator) {
        return Err(Error::NotWhitelisted);
    }
    Ok(())
}

struct State {
    admin: Address,
    whitelist: Vec<Address>,
    whitelist_enabled: bool,
}

#[derive(Clone)]
struct Metadata {
    key: String,
    value: String,
}

#[derive(Clone)]
struct TokenDefinition {
    symbol: String,
    name: String,
    initial_supply: i128,
}

#[derive(Debug)]
pub enum Error {
    Unauthorized,
    NotWhitelisted,
    TokenNotFound,
}
